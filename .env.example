APP_ORIGIN=http://localhost:3000
# Local development database. Integration tests use fenshi_test explicitly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fenshi

# E2E tests must point DATABASE_URL at a database whose name ends in _test.
E2E_ADMIN_PHONE=13900139000
E2E_ADMIN_PASSWORD=replace-with-e2e-admin-password
E2E_USER_PHONE=13800138000
E2E_USER_PASSWORD=replace-with-e2e-temporary-password
E2E_NEW_PASSWORD=replace-with-e2e-permanent-password
E2E_INVALID_PASSWORD=replace-with-e2e-invalid-password
